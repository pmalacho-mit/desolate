#!/bin/sh
# `git push` in a workspace: the branch is OFFERED to the root, and nothing goes to the remote.
#
# A workspace holds no key, so a push from it could never reach GitHub. Before this, it went
# to the read-only mirror and failed with "remote unpack failed: unable to create temporary
# object directory", which told a person (pressing Sync in the editor) nothing. Now each
# clone's push URL is `desolate-offer::<owner/repo>` (init.ts), and git runs this helper,
# which offers each branch pushed (`desolate offer`). It then reports the push as refused,
# so that no origin/<branch> appears here for a branch the remote does not have, and says
# that the refusal is the expected result. An agent read "rejected", followed by "Push it from
# the dashboard", as a failure to solve: what it prints says that nothing more is needed, and
# that only another offer tells the person there is something new (an offer is of one commit,
# #278). A person pressing Sync in the editor reads the same words. They name no branch: the
# offer's own line does, as `desolate offer` made it printable.
#
# git's remote-helper protocol (gitremote-helpers(7)), the push half only: git sends
# "capabilities", "list for-push" (answered with the mirror's branches, which are the
# remote's: so git's own checks, a non-fast-forward among them, see what is there), then a
# batch of "push <src>:<dst>" lines ended by a blank line; each gets "ok <dst>" or
# "error <dst> <why>", and the batch a blank line.
repo=$2
mirror=/desolate/mirrors/$repo.git
pushes='' offered=''
while IFS= read -r line; do
  case $line in
    capabilities) printf 'push\n\n' ;;
    list*) git -c safe.directory="$mirror" --git-dir="$mirror" for-each-ref --format='%(objectname) %(refname)' refs/heads 2>/dev/null; printf '\n' ;;
    push\ *) pushes="$pushes ${line#push }" ;;
    '')
      [ -n "$pushes" ] || exit 0
      for spec in $pushes; do
        spec=${spec#+} src=${spec%%:*} dst=${spec#*:} branch=${dst#refs/heads/}
        # A branch pushed by its own name, or as HEAD while HEAD is that branch: `git push -u
        # origin HEAD`, as agents push a new branch (refused until 2026-11-18, so an agent's
        # branch never reached the dashboard).
        own=''
        [ "$src" = "$dst" ] && own=1
        [ "$src" = HEAD ] && [ "$(git symbolic-ref -q HEAD 2>/dev/null)" = "$dst" ] && own=1
        if [ -z "$src" ]; then
          printf 'error %s not deleted: a workspace changes nothing on the remote; the person deletes branches there (desolate git, on the Mac)\n' "$dst"
        elif [ -z "$own" ] || [ "$branch" = "$dst" ]; then
          printf 'error %s not offered: only a branch is offered, under its own name (git push origin <branch>)\n' "$dst"
        elif desolate offer "$repo" "$branch" >&2; then
          offered=1
          printf 'error %s offered for review, not pushed: this is the expected result, the person reviews and pushes it\n' "$dst"
        else
          printf 'error %s not offered: desolate offer says why above, with its fix\n' "$dst"
        fi
      done
      [ -z "$offered" ] || printf '%s\n' \
        'git reports this push as rejected below, on purpose: nothing goes to the remote from a workspace, and git must not record a branch there that the remote does not have.' \
        'Nothing more is needed now: do not retry the push or look for another way to push.' >&2
      printf '\n'
      pushes='' offered=''
      ;;
  esac
done
