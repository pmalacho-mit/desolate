#!/bin/sh
# `git fetch` and `git pull` in a workspace: what the remote has NOW, not what the mirror
# last fetched. Each clone's origin is `desolate-mirror::<owner/repo>` (init.ts), and git runs
# this helper, which asks the root to refresh the mirror from the remote (the request
# `desolate fetch` makes: the root fetches with its read key; nothing here has one), then
# serves the fetch from the read-only mirror with git's own upload-pack. Before this, `git
# pull` quietly brought only what the mirror had, until someone ran `desolate fetch`.
#
# What the root says while it works on the request (a long fetch) is shown as it comes. If it
# cannot refresh the mirror (offline, the remote down, the root stopped), the fetch still
# happens, from the mirror as it is, and says so. DESOLATE_MIRROR_FRESH=1 skips the request
# (`desolate fetch` has just made it).
#
# git's remote-helper protocol (gitremote-helpers(7)), its "connect" half: git asks to talk
# to git-upload-pack, and this connects it to the mirror's.
repo=$2
mirror=/desolate/mirrors/$repo.git
while IFS= read -r line; do
  case $line in
    capabilities) printf 'connect\n\n' ;;
    'connect git-upload-pack')
      if [ "${DESOLATE_MIRROR_FRESH:-}" != 1 ] && ! desolate fetch --mirror-only "$repo" >/dev/null; then
        printf 'desolate: fetching what the mirror has of %s, as it is\n' "$repo" >&2
      fi
      printf '\n'
      exec git -c safe.directory="$mirror" upload-pack "$mirror"
      ;;
    connect\ *) printf 'fallback\n' ;;
    '') exit 0 ;;
  esac
done
